{
  "name": "@web-checkout/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web Checkout API: menu, idempotent order submission, status lookup, simulated payment.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project api-unit",
    "test:integration": "vitest run --project api-integration"
  },
  "dependencies": {
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "~6.0.2",
    "vitest": "4.1.11"
  }
}
